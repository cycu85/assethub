{% extends 'base.html.twig' %}

{% block title %}{{ equipment_set.name }} - {{ app_name() }}{% endblock %}
{% block page_title %}Szczegóły zestawu aparatury{% endblock %}

{% block content %}
<!-- Breadcrumb -->
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <ol class="breadcrumb m-0">
                <li class="breadcrumb-item"><a href="{{ path('dashboard') }}">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="{{ path('aparatura_pomiarowa_index') }}">Aparatura Pomiarowa</a></li>
                <li class="breadcrumb-item"><a href="{{ path('aparatura_pomiarowa_equipment_set_index') }}">Zestawy</a></li>
                <li class="breadcrumb-item active">{{ equipment_set.name }}</li>
            </ol>
        </div>
    </div>
</div>

<!-- Header -->
<div class="row mb-4">
    <div class="col-md-8">
        <div class="d-flex align-items-center">
            <div class="avatar-lg bg-info rounded me-3">
                <i class="ri-stack-line text-white fs-24"></i>
            </div>
            <div>
                <h4 class="mb-1">{{ equipment_set.name }}</h4>
                <p class="text-muted mb-0">
                    {% set status_class = equipment_set.status == 'available' ? 'success' : 
                                         (equipment_set.status == 'assigned' ? 'warning' : 
                                         (equipment_set.status == 'in_review' ? 'info' : 'secondary')) %}
                    <span class="badge bg-{{ status_class }} me-2">{{ equipment_set.statusDisplayName }}</span>
                    <span class="text-muted">{{ equipment_set.equipmentItems|length }} urządzeń</span>
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4 text-end">
        {% if can_edit %}
        <a href="{{ path('aparatura_pomiarowa_equipment_set_edit', {id: equipment_set.id}) }}" class="btn btn-primary">
            <i class="ri-edit-line me-1"></i>Edytuj
        </a>
        {% endif %}
        <a href="{{ path('aparatura_pomiarowa_equipment_set_index') }}" class="btn btn-outline-secondary ms-2">
            <i class="ri-arrow-left-line me-1"></i>Powrót
        </a>
    </div>
</div>

<!-- Informacje podstawowe -->
<div class="row mb-4">
    <div class="col-xl-8">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="ri-information-line me-2"></i>Informacje o zestawie aparatury
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-medium">Nazwa zestawu</label>
                            <p class="mb-0">{{ equipment_set.name }}</p>
                        </div>
                        
                        {% if equipment_set.setType %}
                        <div class="mb-3">
                            <label class="form-label fw-medium">Typ zestawu</label>
                            <p class="mb-0">
                                <span class="badge bg-info">{{ equipment_set.setType }}</span>
                            </p>
                        </div>
                        {% endif %}
                        
                        {% if equipment_set.location %}
                        <div class="mb-3">
                            <label class="form-label fw-medium">Lokalizacja</label>
                            <p class="mb-0">{{ equipment_set.location }}</p>
                        </div>
                        {% endif %}
                    </div>
                    
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-medium">Status</label>
                            <p class="mb-0">
                                <span class="badge bg-{{ status_class }}">{{ equipment_set.statusDisplayName }}</span>
                            </p>
                        </div>
                        
                        {% if equipment_set.assignedTo %}
                        <div class="mb-3">
                            <label class="form-label fw-medium">Przypisany do</label>
                            <p class="mb-0">
                                <i class="ri-user-line me-1"></i>
                                {{ equipment_set.assignedTo.fullName }}
                                {% if equipment_set.assignedDate %}
                                <br><small class="text-muted">od {{ equipment_set.assignedDate|date('d.m.Y') }}</small>
                                {% endif %}
                            </p>
                        </div>
                        {% endif %}
                        
                        {% if equipment_set.nextReviewDate %}
                        <div class="mb-3">
                            <label class="form-label fw-medium">Następna kalibracja</label>
                            <p class="mb-0">
                                {% set days_to_review = date(equipment_set.nextReviewDate).diff(date()).days %}
                                {% if days_to_review < 0 %}
                                    <span class="text-danger">
                                        <i class="ri-error-warning-line me-1"></i>
                                        {{ equipment_set.nextReviewDate|date('d.m.Y') }} (przeterminowana!)
                                    </span>
                                {% elseif days_to_review <= 30 %}
                                    <span class="text-warning">
                                        <i class="ri-time-line me-1"></i>
                                        {{ equipment_set.nextReviewDate|date('d.m.Y') }} (za {{ days_to_review }} dni)
                                    </span>
                                {% else %}
                                    <span class="text-success">
                                        {{ equipment_set.nextReviewDate|date('d.m.Y') }}
                                    </span>
                                {% endif %}
                            </p>
                        </div>
                        {% endif %}
                    </div>
                </div>
                
                {% if equipment_set.description %}
                <div class="mt-3">
                    <label class="form-label fw-medium">Opis</label>
                    <p class="mb-0">{{ equipment_set.description|nl2br }}</p>
                </div>
                {% endif %}
            </div>
        </div>

        <!-- Lista urządzeń w zestawie -->
        <div class="card">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="ri-scales-line me-2"></i>Urządzenia w zestawie ({{ equipment_set.equipmentItems|length }})
                    </h5>
                    {% if can_edit %}
                    <a href="{{ path('aparatura_pomiarowa_equipment_set_add_equipment', {id: equipment_set.id}) }}" 
                       class="btn btn-sm btn-outline-primary">
                        <i class="ri-settings-3-line me-1"></i>Zarządzaj
                    </a>
                    {% endif %}
                </div>
            </div>
            <div class="card-body">
                {% if equipment_set.equipmentItems|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-borderless table-centered align-middle table-nowrap mb-0">
                        <thead class="text-muted">
                            <tr>
                                <th>Urządzenie</th>
                                <th>Typ</th>
                                <th>Status</th>
                                <th>Następna kalibracja</th>
                                <th>Akcje</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for equipment in equipment_set.equipmentItems %}
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm bg-light rounded me-3">
                                            <i class="ri-scales-line text-primary fs-16"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0">
                                                <a href="{{ path('aparatura_pomiarowa_equipment_show', {id: equipment.id}) }}" 
                                                   class="text-dark text-decoration-none">
                                                    {{ equipment.name }}
                                                </a>
                                            </h6>
                                            <span class="text-muted small">{{ equipment.inventoryNumber }}</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">{{ equipment.equipmentType }}</span>
                                </td>
                                <td>
                                    {% set eq_status_class = equipment.status == 'available' ? 'success' : 
                                                             (equipment.status == 'assigned' ? 'warning' : 
                                                             (equipment.status == 'damaged' ? 'danger' : 'secondary')) %}
                                    <span class="badge bg-{{ eq_status_class }}">{{ equipment.statusDisplayName }}</span>
                                </td>
                                <td>
                                    {% if equipment.nextReviewDate %}
                                        {% set eq_review_date = equipment.nextReviewDate|date('Y-m-d') %}
                                        {% set today_date = 'now'|date('Y-m-d') %}
                                        {% if eq_review_date < today_date %}
                                            {% set days_overdue = date().diff(date(equipment.nextReviewDate)).days %}
                                            <span class="text-danger small">
                                                <i class="ri-error-warning-line me-1"></i>
                                                {{ equipment.nextReviewDate|date('d.m.Y') }}
                                                <br>Przeterminowana o {{ days_overdue }} dni!
                                            </span>
                                        {% else %}
                                            {% set days_to_eq_review = date(equipment.nextReviewDate).diff(date()).days %}
                                            {% if days_to_eq_review <= 30 %}
                                                <span class="text-warning small">
                                                    <i class="ri-time-line me-1"></i>
                                                    {{ equipment.nextReviewDate|date('d.m.Y') }}
                                                    <br>Za {{ days_to_eq_review }} dni
                                                </span>
                                            {% else %}
                                                <span class="text-success small">
                                                    {{ equipment.nextReviewDate|date('d.m.Y') }}
                                                </span>
                                            {% endif %}
                                        {% endif %}
                                    {% else %}
                                        <span class="text-muted small">Nie określono</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="dropdown">
                                        <button class="btn btn-light btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                            <i class="ri-more-line"></i>
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <a class="dropdown-item" href="{{ path('aparatura_pomiarowa_equipment_show', {id: equipment.id}) }}">
                                                    <i class="ri-eye-line me-2"></i>Szczegóły
                                                </a>
                                            </li>
                                            {% if can_edit %}
                                            <li>
                                                <a class="dropdown-item" href="{{ path('aparatura_pomiarowa_equipment_edit', {id: equipment.id}) }}">
                                                    <i class="ri-edit-line me-2"></i>Edytuj
                                                </a>
                                            </li>
                                            {% endif %}
                                            {% if can_review %}
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <a class="dropdown-item" href="{{ path('aparatura_pomiarowa_review_new_for_equipment', {id: equipment.id}) }}">
                                                    <i class="ri-search-eye-line me-2"></i>Nowa kalibracja
                                                </a>
                                            </li>
                                            {% endif %}
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% else %}
                <div class="text-center py-4">
                    <i class="ri-scales-line text-muted fs-32"></i>
                    <p class="text-muted mb-0 mt-2">Ten zestaw nie zawiera jeszcze żadnych urządzeń</p>
                    {% if can_edit %}
                    <a href="{{ path('aparatura_pomiarowa_equipment_set_add_equipment', {id: equipment_set.id}) }}" 
                       class="btn btn-primary btn-sm mt-2">
                        <i class="ri-add-line me-1"></i>Dodaj urządzenia
                    </a>
                    {% endif %}
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <!-- Przypisanie -->
        {% if equipment_set.assignedTo %}
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="ri-user-line me-2"></i>Przypisanie
                </h5>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="avatar-sm bg-warning rounded me-3">
                        <i class="ri-user-line text-white fs-16"></i>
                    </div>
                    <div>
                        <h6 class="mb-0">{{ equipment_set.assignedTo.fullName }}</h6>
                        {% if equipment_set.assignedDate %}
                        <small class="text-muted">od {{ equipment_set.assignedDate|date('d.m.Y H:i') }}</small>
                        {% endif %}
                    </div>
                </div>
                
                {% if can_assign %}
                <div class="mt-3">
                    <form method="POST" action="{{ path('aparatura_pomiarowa_equipment_set_unassign', {id: equipment_set.id}) }}" 
                          onsubmit="return confirm('Czy na pewno cofnąć przypisanie zestawu?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('unassign_equipment_set_' ~ equipment_set.id) }}">
                        <button type="submit" class="btn btn-outline-warning btn-sm">
                            <i class="ri-user-unfollow-line me-1"></i>Cofnij przypisanie
                        </button>
                    </form>
                </div>
                {% endif %}
            </div>
        </div>
        {% endif %}

        <!-- Kalibracje zestawu -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="ri-search-eye-line me-2"></i>Kalibracje zestawu
                </h5>
            </div>
            <div class="card-body">
                {% if equipment_set.nextReviewDate %}
                <div class="mb-3">
                    <label class="text-muted small">Następna kalibracja</label>
                    <p class="mb-0">
                        {% set days_to_review = date(equipment_set.nextReviewDate).diff(date()).days %}
                        {% if days_to_review < 0 %}
                            <span class="text-danger fw-medium">
                                {{ equipment_set.nextReviewDate|date('d.m.Y') }}
                                <br><small>Przeterminowana!</small>
                            </span>
                        {% elseif days_to_review <= 30 %}
                            <span class="text-warning fw-medium">
                                {{ equipment_set.nextReviewDate|date('d.m.Y') }}
                                <br><small>Za {{ days_to_review }} dni</small>
                            </span>
                        {% else %}
                            <span class="fw-medium">
                                {{ equipment_set.nextReviewDate|date('d.m.Y') }}
                                <br><small class="text-muted">Za {{ days_to_review }} dni</small>
                            </span>
                        {% endif %}
                    </p>
                </div>
                {% endif %}

                {% set lastReview = equipment_set.lastReview %}
                {% if lastReview %}
                <div class="mb-3">
                    <label class="text-muted small">Ostatnia kalibracja</label>
                    <p class="mb-0">
                        <a href="{{ path('aparatura_pomiarowa_review_show', {id: lastReview.id}) }}" class="text-decoration-none">
                            {{ lastReview.completedDate|date('d.m.Y') }}
                            <i class="ri-external-link-line ms-1 small"></i>
                        </a>
                        <br><small class="text-muted">{{ lastReview.resultDisplayName }}</small>
                    </p>
                </div>
                {% endif %}
                
                <div class="d-grid">
                    {% if can_review %}
                    <a href="{{ path('aparatura_pomiarowa_review_new_for_set', {id: equipment_set.id}) }}" 
                       class="btn btn-outline-primary btn-sm">
                        <i class="ri-add-line me-1"></i>Nowa kalibracja
                    </a>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Metadane -->
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="ri-information-line me-2"></i>Informacje systemowe
                </h5>
            </div>
            <div class="card-body">
                <div class="mb-2">
                    <label class="text-muted small">Utworzony</label>
                    <p class="mb-0 small">{{ equipment_set.createdAt|date('d.m.Y H:i') }}</p>
                    {% if equipment_set.createdBy %}
                    <small class="text-muted">przez {{ equipment_set.createdBy.fullName }}</small>
                    {% endif %}
                </div>
                {% if equipment_set.updatedAt and equipment_set.updatedAt != equipment_set.createdAt %}
                <div class="mb-0">
                    <label class="text-muted small">Ostatnia modyfikacja</label>
                    <p class="mb-0 small">{{ equipment_set.updatedAt|date('d.m.Y H:i') }}</p>
                    {% if equipment_set.updatedBy %}
                    <small class="text-muted">przez {{ equipment_set.updatedBy.fullName }}</small>
                    {% endif %}
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}